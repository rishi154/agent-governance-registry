# Copy this file to .env and fill in your values

# Google Cloud — required for AI governance reviews
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Optional overrides
# VERTEX_REGION=us-east5
# VERTEX_CLAUDE_MODEL=claude-sonnet-4-6

# Authentication — API keys for marketplace access
# Generate secure keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
MARKETPLACE_ADMIN_KEY=change-me-admin-key-here
MARKETPLACE_DEV_KEY=change-me-dev-key-here
MARKETPLACE_VIEWER_KEY=change-me-viewer-key-here

# Optional: Allow unauthenticated read access (for internal tools)
# ALLOW_UNAUTHENTICATED_READ=true

# Optional: Notifications (Slack or Microsoft Teams webhook URL)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
# TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...
